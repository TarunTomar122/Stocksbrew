# Not installed by default. To enable on the VPS:
#   sudo cp backend/vps/units/tikrr-agentdata-weekly.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tikrr-agentdata-weekly.timer
[Unit]
Description=Tikrr agent data: 13F funds, fund holders and House reports, weekly

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/tikrr
Environment=TIKRR_REPO_DIR=/opt/tikrr
Environment=TIKRR_ENV_FILE=/etc/tikrr/backend.env
MemoryMax=2G
ExecStart=/opt/tikrr/backend/vps/run-agentdata.sh weekly
