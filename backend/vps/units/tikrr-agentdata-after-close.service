# Not installed by default. To enable on the VPS:
#   sudo cp backend/vps/units/tikrr-agentdata-after-close.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tikrr-agentdata-after-close.timer
[Unit]
Description=Tikrr agent data: prices, strategies, earnings, screener and agents after the US close

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/tikrr
Environment=TIKRR_REPO_DIR=/opt/tikrr
Environment=TIKRR_ENV_FILE=/etc/tikrr/backend.env
MemoryMax=2G
ExecStart=/opt/tikrr/backend/vps/run-agentdata.sh after_close
