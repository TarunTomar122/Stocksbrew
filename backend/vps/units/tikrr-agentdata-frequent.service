# Not installed by default. To enable on the VPS:
#   sudo cp backend/vps/units/tikrr-agentdata-frequent.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tikrr-agentdata-frequent.timer
[Unit]
Description=Tikrr agent data: the wire and markets, every 30 minutes

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/tikrr
Environment=TIKRR_REPO_DIR=/opt/tikrr
Environment=TIKRR_ENV_FILE=/etc/tikrr/backend.env
MemoryMax=1G
ExecStart=/opt/tikrr/backend/vps/run-agentdata.sh frequent
