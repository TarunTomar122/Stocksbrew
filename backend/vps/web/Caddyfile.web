# stocksbrew.online, self-hosted: Caddy gets and renews the certificate itself once DNS points here.
stocksbrew.online, www.stocksbrew.online {
	bind 144.217.6.112
	# The app's own address is www (NEXT_PUBLIC_APP_URL): the bare domain sends people there.
	@apex host stocksbrew.online
	redir @apex https://www.stocksbrew.online{uri} permanent
	# Every request with its status and duration (JSON), for tracing slow or failed pages:
	#   sudo tail -f /var/log/caddy/stocksbrew.log | jq -c 'select(.status>=500 or .duration>3)'
	log {
		output file /var/log/caddy/stocksbrew.log {
			roll_size 50MiB
			roll_keep 10
		}
		# No full visitor IPs at rest (the analytics promise): keep only the network part, and drop cookies and auth.
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Forwarded-For delete
			}
		}
	}
	# Cache bans are for processes on this box only (varnish.vcl checks too): never from the internet.
	@cachecontrol method BAN PURGE
	respond @cachecontrol 405
	encode zstd gzip
	# Next's build assets are content-hashed, so browsers can keep them for a year.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	# Varnish (127.0.0.1:6081, backend/vps/web/varnish.vcl) caches the public routes and balances the Next instances.
	reverse_proxy 127.0.0.1:6081 {
		# Next writes absolute redirects from its own bind address (http://localhost:300x/...): point them at the
		# public address instead.
		header_down Location "^http://localhost:30[0-9][0-9](.*)$" "https://www.stocksbrew.online$1"
	}
}
