# The stocksbrew web app, self-hosted (moved off Vercel on 2026-11-13).
# Runs the Next.js standalone build in /opt/tikrr-web/current, bound to localhost. Caddy (HTTPS) -> Varnish (cache
# for the routes that are the same for everyone) -> these instances. Secrets live in /etc/tikrr/web.env (mode 600, never committed).
[Unit]
Description=stocksbrew web (Next.js standalone) on port %i
After=network-online.target tikrr-localdb.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tikrr-web/current
EnvironmentFile=/etc/tikrr/web.env
Environment=NODE_ENV=production
# "localhost", not 127.0.0.1: Next builds its own URLs from this name, and a mismatch makes middleware rewrites
# (the cached signed-out pages) proxy back to itself over https and fail. It still binds to 127.0.0.1 only.
Environment=HOSTNAME=localhost
# One instance per core-ish: tikrr-web@3000 and tikrr-web@3001, load-balanced by Varnish (varnish.vcl).
Environment=PORT=%i
# Heap well under MemoryMax: code, buffers and the render cache live outside it (~300-400 MB).
ExecStart=/usr/local/bin/node --max-old-space-size=768 server.js
Restart=always
RestartSec=3
# The box also runs LocalDB, the data jobs and Firecrawl: keep the web app from crowding them out.
# No MemoryHigh: at 1G it sat below what the heap was allowed to reach, so under load the kernel kept pushing the
# live process into swap and it stopped answering (Nov 14, 03:00-05:40 UTC). Swap is capped instead: an instance
# that outgrows MemoryMax is killed and restarted in seconds (Varnish retries the other one) rather than dragging
# the whole box into swap.
MemoryMax=1536M
MemorySwapMax=128M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
