{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace-money/article_enrichment.schema.json",
  "title": "Trace Money Article Enrichment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "article_id",
    "market",
    "source",
    "title",
    "url",
    "published_at",
    "ingested_at",
    "article_overview",
    "article_key_points",
    "overall_sentiment_score",
    "overall_sentiment_label",
    "event_tags",
    "entities",
    "model",
    "cache_key",
    "enriched_at",
    "coverage_mode"
  ],
  "properties": {
    "article_id": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "enum": ["US", "IN"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_name", "source_kind", "source_lane"],
      "properties": {
        "source_id": { "type": "string" },
        "source_name": { "type": "string" },
        "source_kind": { "type": "string", "enum": ["publisher", "exchange", "regulator"] },
        "source_lane": { "type": "string", "enum": ["broad", "core", "promoted"] },
        "source_coverage_modes": {
          "type": "array",
          "items": { "type": "string", "enum": ["market", "sector", "stock"] }
        }
      }
    },
    "coverage_mode": {
      "type": "string",
      "enum": ["market", "sector", "stock"]
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "article_overview": {
      "type": "string"
    },
    "article_key_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 5
    },
    "overall_sentiment_score": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "overall_sentiment_label": {
      "type": "string",
      "enum": ["bullish", "constructive", "mixed", "cautious", "bearish"]
    },
    "event_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "earnings",
          "ratings",
          "guidance",
          "product",
          "contract",
          "macro",
          "regulation",
          "management",
          "supply_chain",
          "ipo",
          "merger",
          "litigation"
        ]
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "name",
          "sentiment_score",
          "sentiment_label",
          "confidence",
          "relevance",
          "entity_overview",
          "entity_key_points"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["stock", "sector", "market"]
          },
          "instrument_id": {
            "type": "string"
          },
          "ticker": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sector_id": {
            "type": "string"
          },
          "market_lane_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["primary", "secondary", "supporting"]
          },
          "sentiment_score": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "sentiment_label": {
            "type": "string",
            "enum": ["bullish", "constructive", "mixed", "cautious", "bearish"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "relevance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "entity_overview": {
            "type": "string"
          },
          "entity_key_points": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4
          }
        }
      }
    },
    "model": {
      "type": "string"
    },
    "cache_key": {
      "type": "string"
    },
    "enriched_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
