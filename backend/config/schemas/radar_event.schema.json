{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace-money/radar_event.schema.json",
  "title": "Trace Money Radar Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "dedupe_key", "market", "instrument_id", "ticker",
    "event_type", "direction", "materiality", "confidence", "novelty",
    "occurred_at", "detected_at", "payload", "citations", "evidence_refs",
    "source_watermark", "what_changed", "why_it_matters", "next_trigger"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "dedupe_key": { "type": "string", "minLength": 1 },
    "market": { "const": "US" },
    "instrument_id": { "type": "string", "pattern": "^US_[A-Z0-9._-]+$" },
    "ticker": { "type": "string", "pattern": "^[A-Z0-9._-]+$" },
    "event_type": {
      "type": "string",
      "enum": [
        "rsi_oversold_cross", "rsi_overbought_cross", "rsi_return_to_neutral",
        "analyst_rating_change", "analyst_target_revision", "earnings_upcoming",
        "earnings_results", "earnings_guidance_change", "filing_catalyst",
        "abnormal_price_move"
      ]
    },
    "direction": { "type": "string", "enum": ["positive", "negative", "neutral", "mixed"] },
    "materiality": { "type": "number", "minimum": 0, "maximum": 100 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
    "novelty": { "type": "number", "minimum": 0, "maximum": 100 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "detected_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "title", "url", "occurred_at"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "occurred_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_watermark": { "type": "string", "minLength": 1 },
    "what_changed": { "type": "string", "minLength": 1 },
    "why_it_matters": { "type": "string", "minLength": 1 },
    "next_trigger": { "type": "string", "minLength": 1 }
  }
}
