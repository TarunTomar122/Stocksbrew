{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace-money/radar_user_view.schema.json",
  "title": "Trace Money Radar User View",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uid", "generated_at", "as_of", "narrative", "attention_items",
    "upcoming_events", "quiet_summary", "source_versions",
    "generated_copy_status", "shadow_mode", "quality"
  ],
  "properties": {
    "uid": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "as_of": { "type": "string", "format": "date-time" },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "body"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "attention_items": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/attention_item" }
    },
    "upcoming_events": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/upcoming_event" }
    },
    "quiet_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_ids", "body", "count"],
      "properties": {
        "instrument_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^US_[A-Z0-9._-]+$" }
        },
        "body": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "source_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "version", "as_of"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "as_of": { "type": "string", "format": "date-time" }
        }
      }
    },
    "generated_copy_status": {
      "type": "string",
      "enum": ["generated", "fallback", "pending", "stale", "failed"]
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "shadow_mode": { "type": "boolean" },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "issues"],
      "properties": {
        "passed": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "publisher", "published_at"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "publisher": { "type": "string", "minLength": 1 },
        "published_at": { "type": "string", "format": "date-time" }
      }
    },
    "attention_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id", "instrument_id", "ticker", "instrument_name", "position_type",
        "event_type", "direction", "headline", "what_changed", "why_it_matters",
        "next_trigger", "occurred_at", "priority", "priority_score",
        "event_ids", "citations"
      ],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "instrument_id": { "type": "string", "pattern": "^US_[A-Z0-9._-]+$" },
        "ticker": { "type": "string", "minLength": 1 },
        "instrument_name": { "type": "string", "minLength": 1 },
        "position_type": { "type": "string", "enum": ["holding", "watchlist"] },
        "event_type": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "enum": ["positive", "negative", "neutral", "mixed"] },
        "headline": { "type": "string", "minLength": 1 },
        "what_changed": { "type": "string", "minLength": 1 },
        "why_it_matters": { "type": "string", "minLength": 1 },
        "next_trigger": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
        "priority_score": { "type": "number", "minimum": 0 },
        "event_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "citations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/citation" } }
      }
    },
    "upcoming_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_id", "ticker", "event_type", "expected_at", "description", "confidence"],
      "properties": {
        "instrument_id": { "type": "string", "pattern": "^US_[A-Z0-9._-]+$" },
        "ticker": { "type": "string", "minLength": 1 },
        "event_type": { "const": "earnings" },
        "expected_at": { "type": "string", "format": "date-time" },
        "description": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
