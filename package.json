{
  "name": "trace-money",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "backend:build-news-intel": "python3 -m backend.scripts.build_news_intelligence --market US --universe us_core_155 --max-articles 18",
    "backend:build-news-intel:100": "python3 -m backend.scripts.build_news_intelligence --market US --universe us_core_100 --max-articles 48",
    "backend:build-divergence": "python3 -m backend.scripts.build_divergence --market US",
    "backend:build-per-stock:us": "python3 -m backend.scripts.build_per_stock_intelligence --market US --universe us_core_155",
    "backend:build-per-stock:in": "python3 -m backend.scripts.build_per_stock_intelligence --market IN --universe in_ai_launch",
    "backend:on-demand-news": "python3 -m backend.scripts.process_on_demand_news_jobs",
    "backend:build-news-intel:in": "python3 -m backend.scripts.build_news_intelligence --market IN --universe in_ai_launch --max-articles 36 --skip-materialize",
    "backend:build-stock-intel": "python3 -m backend.scripts.build_stock_intelligence --market US --universe us_core_155",
    "backend:build-thematic-screens:us": "python3 -m backend.scripts.build_thematic_screens --market US --universe us_core_100",
    "backend:build-thematic-screens:in": "python3 -m backend.scripts.build_thematic_screens --market IN --universe in_core_150",
    "backend:build:in": "python3 -m backend.scripts.build_snapshot --market IN",
    "backend:build:in:review": "python3 -m backend.scripts.build_snapshot --market IN --include-review-sources",
    "backend:build:us": "python3 -m backend.scripts.build_snapshot --market US",
    "backend:enrich-news": "python3 -m backend.scripts.enrich_articles --market US --universe us_core_155",
    "backend:ingest-news": "python3 -m backend.scripts.ingest_news --market US --universe us_core_155 --max-articles 18",
    "backend:ingest-news:in": "python3 -m backend.scripts.ingest_news --market IN --universe in_ai_launch --max-articles 36",
    "backend:materialize-views": "python3 -m backend.scripts.materialize_views --market US --universe us_core_155 --activate",
    "backend:materialize-views:100": "python3 -m backend.scripts.materialize_views --market US --universe us_core_100 --activate",
    "backend:materialize-views:in": "python3 -m backend.scripts.materialize_views --market IN --universe in_ai_launch --activate",
    "backend:purge-tikrr-stale": "python3 -m backend.scripts.purge_tikrr_stale_data",
    "backend:seed-tikrr-meta": "python3 -m backend.scripts.seed_tikrr_meta",
    "backend:set-promoted": "python3 -m backend.scripts.set_promoted_tickers",
    "backend:sync-config": "python3 -m backend.scripts.sync_config",
    "backend:sync-prices": "python3 -m backend.scripts.sync_price_snapshots --market US --universe us_core_155 --session-phase manual --activate",
    "backend:sync-prices:100": "npm run backend:sync-prices:tracked",
    "backend:sync-prices:in": "python3 -m backend.scripts.sync_price_snapshots --market IN --universe in_core_150 --session-phase manual --activate --max-workers 8",
    "backend:sync-prices:tracked": "python3 -m backend.scripts.sync_price_snapshots --market US --universe us_price_8 --session-phase manual --max-workers 8",
    "backend:sync-universe": "python3 -m backend.scripts.sync_instrument_universe --market US --universe us_core_155 --activate",
    "backend:sync-universe:100": "python3 -m backend.scripts.sync_instrument_universe --market US --universe us_core_100 --activate",
    "backend:sync-universe:in": "python3 -m backend.scripts.sync_instrument_universe --market IN --universe in_core_150 --activate",
    "backend:sync-universe:tracked": "python3 -m backend.scripts.sync_instrument_universe --market US --universe us_price_8",
    "backend:test": "python3 -m unittest discover -s backend/tests",
    "backend:tm:us": "python3 -m backend.scripts.sync_price_snapshots --market US --universe us_core_155 --session-phase manual --activate && python3 -m backend.scripts.ingest_news --market US --universe us_core_155 --max-articles 36 && python3 -m backend.scripts.enrich_articles --market US --universe us_core_155 && python3 -m backend.scripts.build_stock_intelligence --market US --universe us_core_155 && python3 -m backend.scripts.build_news_intelligence --market US --universe us_core_155 --max-articles 36 && python3 -m backend.scripts.materialize_views --market US --universe us_core_155 --activate",
    "build": "next build",
    "dev": "next dev",
    "remotion": "remotion studio",
    "remotion:render": "remotion render TikrrLaunch out/tikrr-launch.mp4",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "fast-xml-parser": "^5.3.1",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.7.0",
    "geist": "^1.7.0",
    "next": "13.5.11",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "standardwebhooks": "^1.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.457",
    "@remotion/google-fonts": "^4.0.457",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "24.12.2",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.1",
    "eslint-config-next": "13.5.11",
    "postcss": "^8.5.8",
    "remotion": "^4.0.457",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
