{
  "name": "trace-money",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "backend:sync-config": "python3 -m backend.scripts.sync_config",
    "backend:seed-tikrr-meta": "python3 -m backend.scripts.seed_tikrr_meta",
    "backend:bootstrap-tikrr-dynamic": "python3 -m backend.scripts.bootstrap_tikrr_dynamic",
    "backend:test-tikrr-stock": "python3 -m backend.scripts.test_tikrr_stock_pipeline",
    "backend:demo-tikrr-batch": "python3 -m backend.scripts.run_tikrr_demo_batch",
    "backend:demo-tikrr-focus": "python3 -m backend.scripts.run_tikrr_demo_batch --market US",
    "backend:purge-tikrr-stale": "python3 -m backend.scripts.purge_tikrr_stale_data",
    "backend:sync-universe": "python3 -m backend.scripts.sync_instrument_universe --market US --universe us_test_5 --activate",
    "backend:sync-prices": "python3 -m backend.scripts.sync_price_snapshots --market US --universe us_test_5 --session-phase manual --activate",
    "backend:ingest-news": "python3 -m backend.scripts.ingest_news --market US --universe us_test_5 --max-articles 18",
    "backend:enrich-news": "python3 -m backend.scripts.enrich_articles --market US --universe us_test_5",
    "backend:build-stock-intel": "python3 -m backend.scripts.build_stock_intelligence --market US --universe us_test_5",
    "backend:build-news-intel": "python3 -m backend.scripts.build_news_intelligence --market US --universe us_test_5 --max-articles 18",
    "backend:materialize-views": "python3 -m backend.scripts.materialize_views --market US --universe us_test_5 --activate",
    "backend:sync-universe:100": "python3 -m backend.scripts.sync_instrument_universe --market US --universe us_core_100 --activate",
    "backend:sync-universe:tracked": "python3 -m backend.scripts.sync_instrument_universe --market US --universe us_price_8",
    "backend:sync-prices:tracked": "python3 -m backend.scripts.sync_price_snapshots --market US --universe us_price_8 --session-phase manual --max-workers 8",
    "backend:sync-prices:100": "npm run backend:sync-prices:tracked",
    "backend:build-news-intel:100": "python3 -m backend.scripts.build_news_intelligence --market US --universe us_core_100 --max-articles 48",
    "backend:materialize-views:100": "python3 -m backend.scripts.materialize_views --market US --universe us_core_100 --activate",
    "backend:sync-universe:in": "python3 -m backend.scripts.sync_instrument_universe --market IN --universe in_test_5 --activate",
    "backend:sync-prices:in": "python3 -m backend.scripts.sync_price_snapshots --market IN --universe in_price_5 --session-phase manual",
    "backend:ingest-news:in": "python3 -m backend.scripts.ingest_news --market IN --universe in_test_5 --max-articles 18",
    "backend:build-news-intel:in": "python3 -m backend.scripts.build_news_intelligence --market IN --universe in_test_5 --max-articles 18 --skip-materialize",
    "backend:materialize-views:in": "python3 -m backend.scripts.materialize_views --market IN --universe in_test_5 --activate",
    "backend:build:in": "python3 -m backend.scripts.build_snapshot --market IN",
    "backend:build:in:review": "python3 -m backend.scripts.build_snapshot --market IN --include-review-sources",
    "backend:build:us": "python3 -m backend.scripts.build_snapshot --market US",
    "backend:set-promoted": "python3 -m backend.scripts.set_promoted_tickers",
    "backend:test": "python3 -m unittest discover -s backend/tests"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "fast-xml-parser": "^5.3.1",
    "firebase-admin": "^13.7.0",
    "geist": "^1.7.0",
    "next": "13.5.11",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.1",
    "eslint-config-next": "13.5.11",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
