# stocksbrew environment variables
#
# Copy to .env.local (web app, Next.js) and/or backend/.env (Python jobs).
# Both files are gitignored. Never commit real values.
# Every variable below is read somewhere in app/, lib/, components/, backend/,
# scripts/ or packages/ (grepped from process.env / os.getenv / os.environ).
# Leave a line empty when you don't use that feature; most code skips it.

# ---------------------------------------------------------------------------
# Core: database (LocalDB) and Firebase Auth
# ---------------------------------------------------------------------------
# LocalDB is the SQLite document store in backend/localdb. The web app talks to
# it over HTTP; jobs on the same machine can write the file directly.
LOCALDB_URL=                      # REQUIRED for the web app, e.g. http://127.0.0.1:8500
LOCALDB_API_TOKEN=                # REQUIRED: long random string, the same value the server is started with
LOCALDB_PATH=                     # path to documents.sqlite3 (server and direct-write jobs)
LOCALDB_HOST=                     # server bind host, default 127.0.0.1
LOCALDB_PORT=                     # server port, default 8500
LOCALDB_ALLOWED_COLLECTIONS=      # optional comma list to restrict the HTTP API
LOCALDB_MAX_CONCURRENCY=          # web adapter: pin max parallel requests (default 6, 16 once the server sends X-LocalDB-Backlog)
LOCALDB_TIMING=                   # web adapter: 1 to log request timings
LOCALDB_TIMING_FILE=              # web adapter: write timings to this file
LOCALDB_MIGRATION_CHECKPOINT=     # migrate_firestore_to_local.py checkpoint path
FIRESTORE_BACKEND=                # "firebase" only for an explicit rollback to Firestore
FIRESTORE_MIGRATION_COLLECTIONS=  # migration script selector override

# Firebase Admin (server): Auth and rollback. One of these two.
FIREBASE_SERVICE_ACCOUNT_PATH=    # REQUIRED (or _JSON): path to a service-account JSON, kept outside the repo
FIREBASE_SERVICE_ACCOUNT_JSON=    # or the JSON itself, in the environment only
GOOGLE_APPLICATION_CREDENTIALS=   # used by some backend scripts instead of the two above
FIREBASE_PROJECT_ID=              # migration script

# Firebase web SDK (browser sign-in). Public by design; without them sign-in fails.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=              # e.g. http://localhost:8000
NEXT_PUBLIC_WAITLIST_MODE=        # 1 to put the site behind the waitlist
NEXT_PUBLIC_DEV_UNLOCK_PRO=       # dev only: treat every user as Pro
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
REVALIDATE_TOKEN=                 # shared secret for /api/revalidate
INDEXNOW_SECRET=                  # protects /api/seo/indexnow
SITE_URL=                         # scripts/submit-indexnow.mjs
ON_DEMAND_PUBLIC_DAILY_CAP=       # cap on public on-demand research requests
EMAIL_UNSUBSCRIBE_SECRET=         # HMAC key for unsubscribe links (web and Python must match)

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_TOKEN=
POSTHOG_PERSONAL_API_KEY=

# Payments (optional; Dodo Payments)
DODO_API_KEY=
DODO_MODE=                        # test or live
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID_MONTHLY=
DODO_PRODUCT_ID_YEARLY=
DODO_PRODUCT_ID_INDIA=

# ---------------------------------------------------------------------------
# AI models (optional; features degrade to rules or are hidden without them)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=                   # web search for chat and pre-earnings reads
ASK_ANTHROPIC_MODEL=
ASK_OPENROUTER_MODEL=
OPENAI_MODEL=
LLM_PROVIDER=
LLM_MODEL=
LLM_REASONING_EFFORT=
LLM_ENRICHMENT_PROVIDER=
LLM_ENRICHMENT_MODEL=
STOCK_BRIEF_PROVIDER=
STOCK_BRIEF_MODEL=
STOCK_BRIEF_REASONING_EFFORT=
NEWS_TONE_MODEL=
TIKRR_PIPELINE_MODEL=
CALL_ENGINE_MODE=                 # off (default) | shadow | on: whether briefs use the rules-based call engine
CALL_STABILITY_MODE=              # off (default) | shadow | on: hold each call steady (backend/call_stability.py)
EVIDENCE_HISTORY_MODE=            # on to keep dated evidence history in briefs (off by default)
TRACE_MONEY_LLM_CONCURRENCY=
TYPESAFE_API_KEY=                 # backend/jev_qa.py (optional QA tool)
SCALEDOWN_API_KEY=                # backend/scripts/compare_scaledown_llm.py (experiment)

# ---------------------------------------------------------------------------
# Market data and news providers (each one's terms apply; see README)
# ---------------------------------------------------------------------------
SEC_USER_AGENT=                   # "yourapp research (you@example.com)"; SEC requires a contact
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=                  # backend/news_finnhub.py (skipped when empty)
MARKETAUX_API_KEY=                # backend/news_marketaux.py (skipped when empty)
TWELVE_DATA_API_KEY=
OPENFIGI_API_KEY=                 # 13F CUSIP to ticker mapping
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
FIRECRAWL_BATCH_POLL_SECONDS=
FIRECRAWL_BATCH_TIMEOUT_SECONDS=
EXTRACT_PROVIDER=                 # article extraction backend
CONTEXT_API_KEY=
CONTEXT_DEV_API_KEY=
CONTEXT_API_URL=
CONTEXT_SEARCH_URL=
CONTEXT_FALLBACK_ARTICLES_PER_TICKER=
CONTEXT_FALLBACK_LOOKBACK_HOURS=
CONTEXT_FALLBACK_MAX_TICKERS=
SCRAPECREATORS_API_KEY=           # Truth Social posts
TRUTH_SOCIAL_API_KEY=
TRUTH_SOCIAL_USER_ID=
BARGO_API_KEY=                    # congressional trades feed
SEARXNG_BASE_URL=
STOCKANALYSIS_USER_AGENT=
STOCKANALYSIS_MAX_ATTEMPTS=
STOCKANALYSIS_MIN_INTERVAL_SECONDS=
TIKRR_YFINANCE_CACHE_ROOT=

# ---------------------------------------------------------------------------
# Email (optional; Brevo)
# ---------------------------------------------------------------------------
BREVO_API_KEY=
EMAILS_ENABLED=                   # must be 1 for anything to send
STOCKSBREW_FROM_EMAIL=
STOCKSBREW_FROM_NAME=
STOCKSBREW_REPLY_TO=
MAIL_APP_URL=
PAUSE_DIRECTIVE_CHANGE_EMAILS=
MAIL_V2_ACTIVE=                   # 1 once the backend/mail jobs own scheduled email (see backend/vps/install-mail-timers.sh)

# ---------------------------------------------------------------------------
# Jobs on a server (backend/vps)
# ---------------------------------------------------------------------------
TIKRR_ENV_FILE=                   # env file the run scripts source
TIKRR_REPO_DIR=
TIKRR_AGENTDATA_DIR=
TIKRR_AGENTDATA_LOCK=
TIKRR_LOCK_DIR=
TIKRR_USER=
TIKRR_SERVICE_MEMORY_MAX=
TIKRR_SERVICE_MEMORY_SWAP_MAX=
TIKRR_VPS_HOST=                   # deploy-code.sh target (default: ssh alias "vps")
TIKRR_VPS_REMOTE=
ENABLE_TIMERS=
UNIT_DIR=
PYTHON_BIN=
WEB_REVALIDATE_BASE_URL=
WEB_REVALIDATE_TOKEN=
WEB_REVALIDATE_TOKEN_FILE=
WEB_REVALIDATE_PATHS=
TRACE_MONEY_LOG_LEVEL=
ANOMALY_CONTEXT_RESCUE_LOOKBACK_HOURS=
ANOMALY_INTELLIGENCE_MAX_AGE_HOURS=
# run-dispatch.sh lane knobs
LANE=
MARKET=
UNIVERSE=
LIMIT=
SHARD_SIZE=
MAX_PARALLEL=
CHUNK_WORKERS=
PER_STOCK_CAP=
DRY_RUN=

# Old tikrr_pipeline client and CLI package
TIKRR_API_BASE_URL=
TIKRR_API_KEY=
TIKRR_SECRET_KEY=
STOCKSBREW_URL=                   # packages/stocksbrew-cli
STOCKSBREW_TOKEN=                 # packages/stocksbrew-cli

# ---------------------------------------------------------------------------
# Legacy: Google Cloud Run jobs (backend/cloudrun, retired; schedulers paused)
# ---------------------------------------------------------------------------
# GOOGLE_CLOUD_PROJECT= GOOGLE_CLOUD_REGION= SCHEDULER_LOCATION= TIKRR_JOB_EXECUTOR=
# SERVICE_ACCOUNT_EMAIL= SCHEDULER_SERVICE_ACCOUNT_EMAIL= IMAGE_NAME= SKIP_BUILD=
# CLOUD_RUN_JOB_MAX_RETRIES= EXECUTION_LIMIT= JOB_NAME= DISPATCH_JOB_NAME= RUN_ID=
# FIREBASE_SECRET_NAME= OPENAI_SECRET_NAME= BREVO_SECRET_NAME= TAVILY_SECRET_NAME= TWELVE_DATA_SECRET_NAME=
# INTRADAY_LIMIT_CAP= INTRADAY_MAX_PARALLEL_CAP= INTRADAY_SHARD_SIZE_MIN= INSTRUMENT_IDS= SESSION_PHASE=
# MAX_WORKERS= MAX_EVENTS= UPCOMING_DAYS= FORCE= MARKET_EVENTS_OPEN_SKIP_IF_FRESH_HOURS=
# REDDIT_CACHE_HOURS= REDDIT_SUBREDDIT_BATCH_SIZE= STOCK_FACTS_LIMIT= STOCK_FACTS_MAX_WORKERS= STOCK_REQUESTS_LIMIT=
# *_JOB_NAME (one per lane, see backend/cloudrun/orchestrator/dispatch.py) and CRON_* (one per schedule,
# see backend/cloudrun/scripts/setup-scheduler.sh)
#
# Maintainer dev-box tooling on the server (backend/vps/setup-*.sh, t3vps); not needed to run stocksbrew:
# OPENCODE_API_KEY= OPENCODE_GO_API_KEY= TS_IP=

# Screenshot import: key for hashing signed-out visitors' addresses (any long random string)
IMPORT_HASH_SECRET=

# The tighter Free/Pro line (lib/paywall-flag.ts): Free covers 3 stocks instead of 5, runs 1 agent instead of 2,
# and filing/news agents become Pro. Off unless exactly 1. Set it in Vercel AND in the VPS backend env (the mail
# and agent jobs read it too, backend/subscription_entitlement.py) in the same change, or emails and the app disagree.
PAYWALL_V2=
